# Backend URL. Defaults to http://localhost:4000 in code if this isn't set
# at all, which is correct for local dev. Set this in your deploy platform
# (e.g. Render's dashboard, as a build-time env var since Vite bakes
# VITE_* values in at build time) to your deployed backend's URL.
VITE_API_URL=https://your-backend.onrender.com
