# Copy this file to `.env` (same folder) and fill in the first three values.
# `.env` is git-ignored. Never commit it, paste it in chat, or share it.

# From https://developer.schwab.com -> Dashboard -> your app -> "App Key" / "Secret"
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Must EXACTLY match the Callback URL registered on your Schwab developer app.
# Use 127.0.0.1 (not "localhost") and include a port.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# ---- Everything below is written automatically by `python trader.py auth login` ----
# Hashed account id that Schwab's API uses instead of your real account number.
SCHWAB_ACCOUNT_HASH=
# OAuth token (base64-encoded JSON). Refreshed automatically; expires after 7 days.
SCHWAB_TOKEN=
