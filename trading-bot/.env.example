# ---- Charles Schwab Trader API credentials ----
# Create an app at https://developer.schwab.com (product: "Accounts and Trading
# Production" + "Market Data Production"). Wait for status "Ready For Use".
# NEVER commit the real .env file or paste these into a chat.
SCHWAB_APP_KEY=your_app_key
SCHWAB_APP_SECRET=your_app_secret
# Must match the callback URL in your Schwab app config EXACTLY.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Where the OAuth token is stored. Keep it private (chmod 600). Schwab refresh
# tokens expire after 7 days, so you must re-run `tradebot auth` weekly.
SCHWAB_TOKEN_PATH=state/schwab_token.json
# Optional: pin the account hash to trade (see `tradebot accounts`). If unset
# and you have exactly one account, that one is used.
# SCHWAB_ACCOUNT_HASH=

# ---- Live trading safety interlock ----
# Live orders are only sent when BOTH config.toml has
# [execution] live_trading_enabled = true AND this variable is set exactly:
# TRADEBOT_LIVE_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
