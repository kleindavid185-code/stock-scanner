# Get these from https://app.alpaca.markets/paper/dashboard/overview
# Use a PAPER/DATA-ONLY key pair -- this app never places trades, but
# using paper keys means there is zero way for it to touch real money
# even if a trading endpoint were called by mistake.
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Free IEX feed by default. Alpaca free tier = IEX data (partial market volume).
ALPACA_DATA_FEED=iex

# For the AI search box in the app. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# For the Earnings page. Get a free key at https://www.alphavantage.co/support/#api-key
# Free tier is call-limited (historically ~25 requests/day) -- the backend
# caches earnings responses for hours to stay well under that.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Used to sign login session tokens -- generate a long random string, keep
# it secret, and don't change it in production (changing it logs everyone out).
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=generate_a_long_random_string_here

# The account that automatically gets 'owner' role (full access + admin
# panel) at signup, and that `npm run set-owner` targets.
OWNER_EMAIL=your_email_here

# Frontend origin(s) allowed to call this API (comma-separated for more than
# one, e.g. a custom domain plus the onrender.com URL). Defaults to the
# local Vite dev server if unset -- set this to your deployed frontend's
# URL in production.
CORS_ORIGIN=http://localhost:5173

PORT=4000
